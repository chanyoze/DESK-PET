      "walk": ["그냥 둘러보는 거야. 따라오든 말든.", "여긴 하수도보단 낫네. 훨씬.", "길 잃으면… 뭐, 원 그려 놓고 기다리지.", "산책 중. 아주 평범한 화요일처럼."],
      "run": ["뒤에 뭐 따라오는 거 아니지!?", "안 뛰면 늦는다고!", "하아… 체력은 공부로 안 늘더라."],
      "sit": ["잠깐만 책 읽을게. 말 걸지 마.", "다리 아파. 촌구석 길이 다 이렇지.", "여기 앉아 있으면 아무도 신경 안 쓰겠지."],
      "sleep": ["음냐… 사이다…", "론돈… 간판은 까만색으로…", "…zzz"],
      "morning": ["아침부터 달 얘기는 사양이야.", "일어났어, 잠꾸러기? 나도 방금."],
      "afternoon": ["점심 먹었어? 난 사이다면 돼.", "오후엔 서점 가기 딱 좋은데."],
      "evening": ["해 지면 괜히 창문 쪽 보게 된단 말이야.", "오늘도 무사히 넘겼네. 대단하다, 우리."],
      "night": ["밤엔 창밖 보지 마. …농담이야. 아마도.", "이 시간까지 안 자면 달이 쳐다본대. 방금 지어낸 말이야.", "슬슬 자. 나도 잘 거야. 진짜로."],
      "longRun": ["너 몇 시간째야? 나도 지겨운데.", "계속 켜 두는 거 보니 나 좀 마음에 드나 봐?"],
      "picked": ["야! 오컬티스트는 소중히 다뤄!", "어, 어디 데려가는 건데?", "내려놔. 지금 당장."],
      "thrown": ["이건 평범한 납치가 아니잖아!", "으아아악—!", "기억해 둘 거야!"],
      "landed": ["…멀쩡해. 무서운 티 안 냈지?", "아야. 다음엔 원 그려 놓고 던져.", "하… 착지는 공부에 없었는데."],
      "petted": ["뭐야, 갑자기? …싫단 말은 안 했어.", "머리 헝클어지잖아. …조금만이야.", "이거 무슨 의식이야?"],
      "woken": ["잠꾸러기는 너거든? …아, 지금은 나구나.", "으음… 딱 좋은 꿈이었는데.", "안 잤어. 눈만 감고 있었어."],
      "together": ["키 큰 애, 또 뒤에 서 있지? 옆으로 와.", "쟤 또 나 쳐다본다… 모른 척해 줘.", "둘이 있으니까 덜 무섭긴 하네. 덜."],
      "armed:knife": ["칼은 분필보다 무거워.", "이건 의식용이야. 아마도.", "베는 건 싫어. 새기는 건 좋아하지만."],
      "armed:shotgun": ["이게 오컬트보단 확실하겠네.", "반동 때문에 어깨 나갈 것 같아.", "주문 외울 시간 없을 땐 이거지."],
      "armed:pistol": ["빵! …말로 하면 더 멋있는데.", "총 쏘는 오컬티스트. 나쁘지 않네.", "안전장치… 이거 맞지?"]
